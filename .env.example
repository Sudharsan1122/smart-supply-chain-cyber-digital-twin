APP_NAME="Smart Supply Chain Cyber Digital Twin"
APP_VERSION="1.0.0"
ENVIRONMENT=DEBUG
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_twin
DB_USER=postgres
DB_PASSWORD=postgres
DB_ECHO=false
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=supply_chain/telemetry
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_KEY=
OPENWEATHER_API_KEY=
ADAPTER_TIMEOUT_SECONDS=15
ADAPTER_MAX_RETRIES=3
ADAPTER_BACKOFF_FACTOR=0.5
ADAPTER_CACHE_TTL_SECONDS=3600
ADAPTER_RATE_LIMIT_PER_MINUTE=60
EXTERNAL_APIS_ENABLED=true
RISK_WEIGHT_DETECTIONS=0.35
RISK_WEIGHT_TRANSITIONS=0.15
RISK_WEIGHT_INCIDENTS=0.20
RISK_WEIGHT_THREAT_INTEL=0.15
RISK_WEIGHT_CENTRALITY=0.10
RISK_WEIGHT_HEALTH=0.05
RISK_SWEEP_INTERVAL_SECONDS=120
RISK_WINDOW_SECONDS=3600
TRIAGE_TP_THRESHOLD=0.65
TRIAGE_SWEEP_INTERVAL_SECONDS=180
TRIAGE_BATCH_SIZE=50
ML_ENABLED=true
ML_ARTIFACTS_DIR=ml/artifacts
ML_FEATURE_WINDOW_SECONDS=60
ML_MIN_SAMPLES_FOR_TRAINING=200
ML_CONTAMINATION=0.05
ENRICHMENT_INTERVAL_SECONDS=30
ENRICHMENT_TTL_SECONDS=86400
