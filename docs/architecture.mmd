    subgraph L1 [Layer 1 — INGESTION]
        L1A["REST API<br/>POST /api/telemetry · /api/events"]
        L1B["MQTT Broker<br/>supply_chain/telemetry/+ · /events/+"]
        L1C["External Sources<br/>Simulators · IoT Sensors · 3rd Party APIs"]
    end

    subgraph L2 [Layer 2 — VALIDATION & NORMALIZATION]
        L2Box["Validation & Normalization<br/>validators.py (range checks + anomaly flags) · normalizer.py (metric rows + twin state)"]
    end

    subgraph L3 [Layer 3 — STORAGE]
        L3Box[("PostgreSQL 16 — 20 Tables<br/>assets · telemetry · security_events · twin_states · detections · risk_scores · incidents · iocs · attack_stories · blast_radius · triage · ...")]
    end

    subgraph L4 [Layer 4 — CYBER DIGITAL TWIN]
        L4Box["Cyber Digital Twin — NetworkX DiGraph<br/>32 nodes · 16 edges · live state · betweenness centrality · drift detection"]
    end

    subgraph L5 [Layer 5 — DETECTION & ANALYTICS]
        L5A["Detection<br/>9 rules + ML (Isolation Forest, One-Class SVM)"]
        L5B["Correlation<br/>6 rules → incidents"]
        L5C["IOC + Enrichment (C8)<br/>VirusTotal · AbuseIPDB · OTX"]
        L5D["Risk Scoring<br/>6 weighted components"]
    end

    subgraph L6 [Layer 6 — RECONSTRUCTION & IMPACT]
        L6A["Attack Story Engine<br/>Timeline · MITRE tactics · Narrative"]
        L6B["Blast Radius<br/>Topology traversal + decay weighting"]
        L6C["Triage<br/>Auto TP/FP/FN/TN + precision/recall/F1"]
    end

    subgraph L7 [Layer 7 — PRESENTATION]
        L7Box["FastAPI Swagger (:8000) + Flask Dashboard (:5000)<br/>100+ REST endpoints · Live monitoring console · 4 tabs"]
    end

